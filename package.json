{
  "name": "nexo-solar",
  "version": "1.0.0",
  "private": true,
  "description": "Hackathon ByeCode: What Should Happen Next? Recomienda el siguiente paso para cada propuesta comercial.",
  "scripts": {
    "setup": "npm install --prefix backend && npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend",
    "ai:check": "npm run ai:check --prefix backend",
    "ai:eval": "npm run ai:eval --prefix backend --",
    "ai:diagnose": "npm run ai:diagnose --prefix backend",
    "evaluate:kit": "npm run evaluate --prefix backend -- --manifest ../kit/manifest.json --events ../kit/events.jsonl --events ../kit/updates.jsonl --out ../recomendaciones.json"
  }
}
