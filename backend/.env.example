# Copia este archivo como .env y llena solo lo que vayas a usar.
# NUNCA subas el .env con claves reales al repositorio.

# Puerto del API
PORT=3001

# Almacenamiento
# - Si DATABASE_URL está vacío, el sistema guarda todo en memoria (se borra al reiniciar).
# - Con PostgreSQL: postgres://usuario:contraseña@localhost:5432/nexo_solar
DATABASE_URL=
# Bases en la nube con conexión externa (Neon, Supabase, Render externa): DATABASE_SSL=true
DATABASE_SSL=false
# Certificado raíz obtenido y verificado con el proveedor. Ruta relativa a backend/ o absoluta.
# Con SSL se verifican siempre la firma y el nombre del servidor.
DATABASE_SSL_CA_FILE=

# Contraseña de la consola del equipo (/). Vacía = sin contraseña (solo para desarrollo local).
# El portal del cliente (/portal) siempre es público.
ADMIN_PASSWORD=

# Carga 6 empresas ficticias con historial de compras al arrancar si la base está vacía.
SEED_DEMO=false

# Correos al cliente por n8n: acuse de la solicitud, propuesta y comprobante (guía: n8n/README.md).
# N8N_WEBHOOK_URL: Production URL del nodo Webhook. N8N_WEBHOOK_SECRET: el mismo valor de la
# credencial Header Auth (x-nexo-secret) en n8n. Pruébalo con: npm run n8n:check -- tucorreo@gmail.com
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=10000
# Dirección para los enlaces de los correos. Vacía: en Render se toma sola; en local, http://localhost:3001
PUBLIC_URL=

# IA: interpreta los mensajes del cliente y propone el siguiente paso (el asistente).
# Las reglas R1–R6 siempre deciden. Guía paso a paso: docs/GEMINI.md
# AI_PROVIDER puede ser: gemini | anthropic | openai | heuristic
#   gemini    -> Google Gemini (recomendado). Requiere GEMINI_API_KEY
#   anthropic -> API de Claude (requiere ANTHROPIC_API_KEY)
#   openai    -> cualquier API compatible con OpenAI: OpenAI, Groq u Ollama local
#   heuristic -> clasificador de respaldo por reglas, sin red (útil para pruebas)
AI_PROVIDER=heuristic

# Gemini. Crea la clave en Google AI Studio (Get API key) y pégala SOLO en backend/.env.
# Compruébala con: npm run ai:check  (nunca muestra la clave)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cuánto razona el modelo antes de responder: low (rápido) | medium | high
GEMINI_REASONING_EFFORT=low
# true = respuesta con esquema JSON estricto; false = JSON simple (úsalo si npm run ai:diagnose lo recomienda)
GEMINI_STRICT_SCHEMA=true

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# API compatible con OpenAI
# Ejemplos de OPENAI_BASE_URL:
#   OpenAI: https://api.openai.com/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai  (mejor usa AI_PROVIDER=gemini)
#   Ollama: http://localhost:11434/v1   (OPENAI_API_KEY puede ser cualquier texto)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Tiempo máximo por llamada al modelo (ms). Si se excede, se usa el clasificador de respaldo.
AI_TIMEOUT_MS=20000

# Asistente comercial: la IA propone y el backend valida antes de hacer algo.
#   off   -> solo cuando el equipo presiona "Generar propuesta" en la consola
#   draft -> además prepara borradores solo (mensajes nuevos y revisiones programadas); nunca envía
#   auto  -> envía SOLO los borradores que pasan todas las validaciones; lo demás queda para el equipo
ASSISTANT_AUTOPILOT=draft
# Cada cuántos minutos revisa las cotizaciones con revisión pendiente (solo con el reloj en vivo)
ASSISTANT_REVIEW_MINUTES=5
# Tiempo máximo para que la IA proponga (ms). Si se excede, se usa la plantilla.
ASSISTANT_TIMEOUT_MS=60000

# Parámetros de negocio (documentados en NOTA_TECNICA.md)
# Horas sin actividad del cliente antes de proponer un seguimiento breve
FOLLOW_UP_HOURS=48
# Monto a partir del cual se pide revisión humana
HIGH_AMOUNT_MXN=500000
# Seguimientos sin respuesta antes de dejar de insistir
MAX_UNANSWERED_FOLLOWUPS=2
# Margen sobre el tiempo típico de decisión de un buen cliente (1.2 = 20% más)
PATIENCE_MARGIN=1.2
